# Odoo XML-RPC
ODOO_URL=https://industriaspico-industriaspico.odoo.com
ODOO_DB=industriaspico-industriaspico-main-14967325
ODOO_USER=your_user@email.com
ODOO_PASSWORD=your_password_or_api_key

# PostgreSQL — Audit log (base séparée de l'instance Odoo)
AUDIT_DB_DSN=postgresql://user:password@localhost:5432/pipeline_audit

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rut-documents
MINIO_SECURE=false

# Redis Streams — queue async (Sprint 2)
REDIS_URL=redis://localhost:6379/0

# Slack alertes DLQ
SLACK_WEBHOOK_URL=

# Interface HITL (Sprint 2)
HITL_HOST=0.0.0.0
HITL_PORT=8001

# Seuils opérationnels
CONFIDENCE_THRESHOLD=0.92
